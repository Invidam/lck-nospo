# ============================================================================
# lck-nospo 일정·VOD 수집 배치 (LXC 안 호스트 cron, UTC 기준)
# ----------------------------------------------------------------------------
# MODE=fetch 컨테이너를 주기적으로 띄워 치지직 신규 VOD 를 수집한다.
#   fetch → classify(신규) → winners(신규) 후 --rm 으로 스스로 종료.
# 봇은 무상태(SELECT만)라 데이터 갱신 후 재시작 불필요.
#
# 서버 시간대는 UTC. KST 01~12시(Worlds 새벽) 및 17~23시에는 매일 7분마다 실행한다.
#   나머지 KST 00시·13~16시에는 매시간 실행한다.
#   일정 동기화는 같은 MODE=fetch 파이프라인에 포함되며 schedule_sync_runs에 기록된다.
# 증분 수집이라 신규 0건이면 page 1만 보고 종료 → 부하 거의 없음.
#
# 설치 (LXC 안에서):
#   crontab deploy/crontab      # 등록
#   crontab -l                  # 확인
# 공개 일정 피드/치지직 조회를 위해 컨테이너에 인터넷 접속 필요.
# ============================================================================

# 공통 run 명령을 매번 쓰기 번거로우면 아래 셸 변수처럼 관리해도 되나,
# cron 은 라인 단위라 각 줄에 docker run 을 그대로 둔다.
# DATA_MOUNT=/opt/lck-nospo → 컨테이너 /data (봇과 같은 볼륨 공유)

# UTC 00~03·08~14·16~23시 = KST 01~12·17~23시, 7분마다
*/7 0-3,8-14,16-23 * * * docker run --rm --network host --security-opt apparmor=unconfined -e MODE=fetch -e LCK_DB_PATH=/data/videos.sqlite -v /opt/lck-nospo:/data lck-nospo >> /var/log/lck-nospo-fetch.log 2>&1

# UTC 04~07·15시 = KST 00·13~16시, 정각
0 4-7,15 * * * docker run --rm --network host --security-opt apparmor=unconfined -e MODE=fetch -e LCK_DB_PATH=/data/videos.sqlite -v /opt/lck-nospo:/data lck-nospo >> /var/log/lck-nospo-fetch.log 2>&1
